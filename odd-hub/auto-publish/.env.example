# AI 内容生成（三选一，优先级：NIM > DeepSeek > OpenAI）
NIM_API_KEY=nvapi-...          # 推荐：https://integrate.api.nvidia.com
NIM_MODEL=deepseek-ai/deepseek-v3.2  # 可选，默认 deepseek-ai/deepseek-v3.2
# DEEPSEEK_API_KEY=sk-...     # 备选：https://platform.deepseek.com/api_keys
# OPENAI_API_KEY=sk-...       # 备选：https://platform.openai.com/api-keys

# GitHub (auto-set in Actions, set manually for local use)
GITHUB_TOKEN=ghp_...
GITHUB_REPOSITORY=owner/odd-core

# Dev.to
DEVTO_API_KEY=...

# Hashnode
HASHNODE_TOKEN=...
HASHNODE_PUBLICATION_ID=...

# Reddit
REDDIT_CLIENT_ID=...
REDDIT_CLIENT_SECRET=...
REDDIT_USERNAME=...
REDDIT_PASSWORD=...
REDDIT_SUBREDDIT=programming

# Telegram
TELEGRAM_BOT_TOKEN=...
TELEGRAM_CHAT_ID=@your_channel

# 掘金 (Cookie-based, expires ~30 days)
JUEJIN_COOKIE=...

# 即刻 (Cookie-based, expires ~30 days)
JIKE_COOKIE=...
JIKE_TOPIC_ID=...

# 知乎 (Cookie-based, expires ~30 days)
ZHIHU_COOKIE=...
