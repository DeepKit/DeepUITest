{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "uniflow://schemas/workflow_input",
  "title": "Workflow Input Schema",
  "description": "Schema for validating workflow input parameters",
  "type": "object",
  "properties": {
    "session_id": {
      "type": "string",
      "description": "Session identifier",
      "minLength": 1,
      "maxLength": 64
    },
    "user_id": {
      "type": "string",
      "description": "User identifier",
      "minLength": 1,
      "maxLength": 64
    },
    "workflow_id": {
      "type": "string",
      "description": "Target workflow identifier",
      "minLength": 1,
      "maxLength": 128
    },
    "input": {
      "type": "object",
      "description": "Workflow input variables",
      "properties": {
        "query": {
          "type": "string",
          "description": "User query or input text",
          "minLength": 1,
          "maxLength": 10000
        },
        "context": {
          "type": "string",
          "description": "Additional context",
          "maxLength": 50000
        },
        "options": {
          "type": "object",
          "description": "Additional options"
        }
      },
      "required": ["query"]
    },
    "metadata": {
      "type": "object",
      "description": "Request metadata",
      "properties": {
        "timestamp": {
          "type": "string",
          "description": "ISO 8601 timestamp"
        },
        "source": {
          "type": "string",
          "description": "Request source (api, web, cli)"
        },
        "priority": {
          "type": "string",
          "enum": ["low", "normal", "high"],
          "default": "normal"
        }
      }
    }
  },
  "required": ["input"]
}
