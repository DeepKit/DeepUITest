# InkFlow LLM Provider 配置 — iFLYTEK Coding Plan (讯飞编程套餐)
#
# 用法：
#   1. 复制本文件为 .env.iflytek
#   2. 填入真实 apiKey（冒号前后两段都要，即 appId:apiKey 整串）
#   3. 在运行前 source/set 这些环境变量，或在 CLI 传 --llm-* 参数
#
# 验证连通性（跳过未设置 IFLYTEK_API_KEY 的测试）：
#   set IFLYTEK_API_KEY=<同 INK_LLM_API_KEY 的值>
#   pytest tests/test_iflytek_integration.py -v

# --- LLM Gateway 配置 ---
INK_LLM_PROVIDER=openai-compatible
INK_LLM_BASE_URL=https://maas-coding-api.cn-huabei-1.xf-yun.com/v2
INK_LLM_API_KEY=83e14cca3d4042e045c62358f11ffdfa:ZmFkMzNhMWVkOTY0NzYyYmZjZWFmYjFl
INK_LLM_API_KEY_ENV=INK_LLM_API_KEY
INK_LLM_TIMEOUT_SECONDS=60
