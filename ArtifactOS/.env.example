# ArtifactOS Phase 1A — Environment Variables (template)
# Copy this file to .env and fill in values.
# .env is in .gitignore — never commit real credentials.

ARTIFACTOS_DB_USER=your_db_user
ARTIFACTOS_DB_PASS=
ARTIFACTOS_DB_HOST=127.0.0.1
ARTIFACTOS_DB_PORT=5432
ARTIFACTOS_DB_NAME=artifactos_test

# Optional local paths
DELPHI_DCC64=
DEEPBASE_ROOT=../../DeepBase
MEDIA_PUBLISH_ROOT=D:/_Progs/.BetterCiv/tools/media_publish
MEDIA_PUBLISH_RUNTIME_ROOT=