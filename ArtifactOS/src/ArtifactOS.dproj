<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <ProjectGuid>{A1B2C3D4-E5F6-7890-ABCD-EF1234567890}</ProjectGuid>
    <ProjectVersion>19.0</ProjectVersion>
    <MainSource>ArtifactOS.dpr</MainSource>
    <Icon_MainIcon>ArtifactOS.ico</Icon_MainIcon>
    <Config Condition="'$(Config)'==''">Debug</Config>
    <Platform Condition="'$(Platform)'==''">Win64</Platform>
    <SanitizedProjectName>ArtifactOS</SanitizedProjectName>
    <DCC_Platform>Win64</DCC_Platform>
    <DCC_DcuOutput>..\dcu\$(Platform)\$(Config)</DCC_DcuOutput>
    <DCC_ExeOutput>..\bin\$(Platform)\$(Config)</DCC_ExeOutput>
    <DCC_UnitSearchPath>.;core;services;..\..\DeepBase\Core;..\..\DeepBase\Services;..\..\DeepBase\Persistence;..\..\DeepBase\ThirdParty\DB;..\..\DeepBase\Governance;$(DCC_UnitSearchPath)</DCC_UnitSearchPath>
    <DCC_Namespace>System;System.SysUtils;System.Classes;System.Generics.Collections;FireDAC;FireDAC.Comp.Client;FireDAC.Stan.Def;DeepBase;DeepBase.Config;DeepBase.Manager;DeepBase.Persistence.Manager.FireDAC;DeepBase.DB.DoQry;DeepBase.Security</DCC_Namespace>
    <DCC_Define>DEBUG;ARTIFACTOS_PHASE1A;ARTIFACTOS_SHADOW_ONLY;$(DCC_Define)</DCC_Define>
    <DCC_UsePackage>DeepBaseCore;DeepBaseServices;DeepBasePersistence;DeepBaseGovernance</DCC_UsePackage>
  </PropertyGroup>
  <Import Project="$(BDS)\Bin\CodeGear.Delphi.Targets" Condition="Exists('$(BDS)\Bin\CodeGear.Delphi.Targets')" />
</Project>