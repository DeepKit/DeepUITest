unit ViewMain;

interface

uses
  System.SysUtils, System.Types, System.UITypes, System.Classes, System.Variants,
  FMX.Types, FMX.Controls, FMX.Forms, FMX.Dialogs, FMX.Layouts, FMX.StdCtrls,
  FMX.Controls.Presentation, FMX.Edit, FMX.Objects, FMX.TabControl,
  Winapi.Windows, Winapi.Messages, uModels;

type
  TFormMain = class(TForm)
    LayoutRoot: TLayout;
    LayoutTop: TLayout;
    LayoutLeft: TLayout;
    LayoutContent: TLayout;
    LayoutBottom: TLayout;
    
    BtnNewContract: TButton;
    BtnSettings: TButton;
    BtnAbout: TButton;
    
    LblStatus: TLabel;
    PrgProgress: TProgressBar;
    
    StyleBook1: TStyleBook;
    
    procedure FormCreate(Sender: TObject);
    procedure FormDestroy(Sender: TObject);
    procedure FormShow(Sender: TObject);
    procedure BtnNewContractClick(Sender: TObject);
    procedure BtnSettingsClick(Sender: TObject);
  private
    FCurrentState: TVerifyState;
    FSourceCode: string;
    FSourcePath: string;
    FSourceLang: TSourceLanguage;
    FContract: TContract;
    FTestResults: TTestResults;
    FReport: TVerificationReport;
    FCardConfig: TCardConfig;
    FRetryCount: Integer;
    
    procedure SetState(AState: TVerifyState);
    procedure LoadSourceFile(const FilePath: string);
    procedure AnalyzeContract;
    procedure GenerateTest;
    procedure RunTest;
    procedure HandleTestResults(const Results: TTestResults);
    procedure ShowReport;
    procedure ShowCardGenerator;
    procedure UpdateUI;
    procedure CopyCodeToClipboard;
    procedure CopyShareLink;
  public
  end;

var
  FormMain: TFormMain;

implementation

uses
  System.IOUtils, System.Threading,
  UniBase.Manager, UniBase.Logging,
  CtrlAIAdapter, CtrlContracts, CtrlTasks, CtrlTestRunner,
  CtrlReport, CtrlCardGenerator,
  FraDropZone, FraContractEditor, FraTestRunner,
  FraReport, FraCardGenerator, FraSettings,
  uConstants, HelperFiles;

{$R *.fmx}

function SetClipboardText(const Text: string): Boolean;
var
  Data: HGLOBAL;
  P: PChar;
begin
  Result := False;
  if OpenClipboard(0) then
  try
    EmptyClipboard;
    Data := GlobalAlloc(GMEM_MOVEABLE, Length(Text) + 1);
    if Data <> 0 then
    begin
      P := GlobalLock(Data);
      try
        StrCopy(P, PChar(Text));
        Result := SetClipboardData(CF_TEXT, Data) <> 0;
      finally
        GlobalUnlock(Data);
      end;
    end;
  finally
    CloseClipboard;
  end;
end;

procedure TFormMain.FormCreate(Sender: TObject);
begin
  FCurrentState := vsWelcome;
  FRetryCount := 0;
  FSourceLang := slUnknown;
  
  SetState(vsWelcome);
end;

procedure TFormMain.FormDestroy(Sender: TObject);
begin
end;

procedure TFormMain.FormShow(Sender: TObject);
begin
  UniBase.Manager.UniBase.WhenReady(
    procedure
    begin
      Logger.Info('ProgeeLite initialized');
      UpdateUI;
    end);
end;

procedure TFormMain.BtnNewContractClick(Sender: TObject);
var
  OpenDlg: TOpenDialog;
begin
  OpenDlg := TOpenDialog.Create(nil);
  try
    OpenDlg.Filter :=
      'Source Files|*.py;*.js;*.ts;*.go;*.java;*.cs;*.rb;*.php;*.swift;*.kt;' +
      '*.cpp;*.c;*.h;*.rs;*.dart|All Files|*.*';
    OpenDlg.Title := '选择要验证的代码文件';
    
    if OpenDlg.Execute then
      LoadSourceFile(OpenDlg.FileName);
  finally
    OpenDlg.Free;
  end;
end;

procedure TFormMain.BtnSettingsClick(Sender: TObject);
begin
end;

procedure TFormMain.SetState(AState: TVerifyState);
begin
  FCurrentState := AState;
  UpdateUI;
end;

procedure TFormMain.LoadSourceFile(const FilePath: string);
var
  FileSize: Int64;
begin
  FileSize := HelperFiles.GetFileSize(FilePath);
  
  if FileSize > MAX_FILE_SIZE then
  begin
    ShowMessage(Format('文件过大 (%.0f KB)，ProgeeLite 仅支持 %d KB 以内的文件',
      [FileSize / 1024, MAX_FILE_SIZE div 1024]));
    Exit;
  end;
  
  FSourceCode := HelperFiles.ReadFileContent(FilePath);
  FSourcePath := FilePath;
  FSourceLang := DetectLanguage(FilePath);
  
  if FSourceLang = slUnknown then
  begin
    ShowMessage('无法识别的文件类型');
    Exit;
  end;
  
  SetState(vsFileLoaded);
  
  AnalyzeContract;
end;

procedure TFormMain.AnalyzeContract;
var
  Prompt: string;
begin
  SetState(vsAnalyzing);
  LblStatus.Text := 'AI 正在分析代码，推导契约...';
  
  Prompt :=
    'You are a code contract analyzer.' + #13#10 +
    'Analyze the following ' + SourceLanguageToStr(FSourceLang) + ' code and extract a verification contract.' + #13#10 +
    #13#10 +
    'The contract must include:' + #13#10 +
    '1. Function/module purpose (one sentence, Chinese)' + #13#10 +
    '2. At least 3 acceptance scenarios: normal case, edge case, error case' + #13#10 +
    '3. Each scenario must have: input, expected output, description (Chinese)' + #13#10 +
    #13#10 +
    'Output ONLY valid YAML in this exact format:' + #13#10 +
    '---' + #13#10 +
    'contract:' + #13#10 +
    '  title: "功能标题"' + #13#10 +
    '  language: "' + SourceLanguageToStr(FSourceLang) + '"' + #13#10 +
    '  purpose: "这段代码的目的是..."' + #13#10 +
    '  scenarios:' + #13#10 +
    '    - id: S001' + #13#10 +
    '      desc: "正常场景描述"' + #13#10 +
    '      type: normal' + #13#10 +
    '      input: "输入描述或值"' + #13#10 +
    '      expected: "期望输出描述或值"' + #13#10 +
    '    - id: S002' + #13#10 +
    '      desc: "边界场景描述"' + #13#10 +
    '      type: edge' + #13#10 +
    '      input: "..."' + #13#10 +
    '      expected: "..."' + #13#10 +
    '    - id: S003' + #13#10 +
    '      desc: "异常场景描述"' + #13#10 +
    '      type: error' + #13#10 +
    '      input: "..."' + #13#10 +
    '      expected: "..."' + #13#10 +
    '---' + #13#10 +
    #13#10 +
    'Source code:' + #13#10 +
    '```' + SourceLanguageToStr(FSourceLang).ToLower + #13#10 +
    FSourceCode + #13#10 +
    '```';

  AIAdapter.CallAIAsync(Prompt, rlTier1,
    procedure(R: TAIResponse)
    begin
      if R.Success then
      begin
        if ContractController.ParseYAMLContract(R.Content, FContract) then
        begin
          SetState(vsContractReady);
          LblStatus.Text := '契约已生成，请确认';
        end
        else
        begin
          ShowMessage('契约解析失败，请重试');
          SetState(vsFileLoaded);
        end;
      end
      else
      begin
        ShowMessage('AI 调用失败: ' + R.ErrorMsg);
        SetState(vsFileLoaded);
      end;
    end);
end;

procedure TFormMain.GenerateTest;
begin
  SetState(vsGeneratingTest);
  LblStatus.Text := '正在生成测试脚本...';
end;

procedure TFormMain.RunTest;
begin
  SetState(vsRunningTest);
  LblStatus.Text := Format('运行测试中... (第%d轮)', [FRetryCount + 1]);
end;

procedure TFormMain.HandleTestResults(const Results: TTestResults);
begin
  FTestResults := Results;
  
  if Results.OverallPassed then
  begin
    SetState(vsPassed);
    LblStatus.Text := '验证通过！';
    ShowReport;
  end
  else
  begin
    Inc(FRetryCount);
    
    if FRetryCount < MAX_RETRY_COUNT then
    begin
      SetState(vsFixing);
      LblStatus.Text := Format('验证未通过，正在修复（第%d轮）...', [FRetryCount + 1]);
    end
    else
    begin
      SetState(vsFailed);
      LblStatus.Text := '验证失败，请手动检查';
    end;
  end;
end;

procedure TFormMain.ShowReport;
var
  OutputDir, OutputCodePath, SealRecordPath, ShareLink: string;
begin
  FReport := ReportController.CreateReport(FContract, FSourcePath, AIAdapter.Config.ModelTier1);
  ReportController.SaveReport(FReport);
  
  OutputDir := TPath.GetDirectoryName(FSourcePath);
  if OutputDir = '' then
    OutputDir := TDirectory.GetCurrentDirectory;
  
  OutputCodePath := TPath.Combine(OutputDir, 
    TPath.GetFileNameWithoutExtension(FSourcePath) + '_sealed' + TPath.GetExtension(FSourcePath));
  ReportController.SaveOutputCode(FSourceCode, FReport.ReportID, FReport.SealHash, OutputCodePath);
  
  SealRecordPath := TPath.Combine(OutputDir, 
    TPath.GetFileNameWithoutExtension(FSourcePath) + '.seal.txt');
  ReportController.SaveSealRecord(FReport, FSourcePath, SealRecordPath);
  
  ShareLink := Format('https://progeelite.com/share/%s', [FReport.ReportID]);
  
  LblStatus.Text := Format('验证通过！报告: %s', [FReport.ReportID]);
  
  ShowCardGenerator;
end;

procedure TFormMain.CopyCodeToClipboard;
var
  SealedCode: string;
begin
  SealedCode := ReportController.AddSealMark(FSourceCode, FReport.ReportID, FReport.SealHash);
  SetClipboardText(SealedCode);
  ShowMessage('验证后的代码已复制到剪贴板！');
end;

procedure TFormMain.CopyShareLink;
var
  ShareLink: string;
begin
  ShareLink := Format('https://progeelite.com/share/%s', [FReport.ReportID]);
  SetClipboardText(ShareLink);
  ShowMessage('分享链接已复制到剪贴板！');
end;

procedure TFormMain.ShowCardGenerator;
begin
  FCardConfig.Clear;
  FCardConfig.ModuleName := FContract.Title;
  FCardConfig.StatPass := Format('%d/%d', [FReport.GetPassCount, FReport.GetTotalCount]);
  FCardConfig.StatMS := Format('%dms', [FTestResults.ExecutionMS]);
  FCardConfig.StatCoverage := Format('%d%%', [FReport.GetPassRate]);
  
  CardGeneratorController.GenerateCard(FCardConfig);
end;

procedure TFormMain.UpdateUI;
begin
  BtnNewContract.Enabled := FCurrentState in [vsIdle, vsFileLoaded, vsFailed];
  
  case FCurrentState of
    vsIdle: LblStatus.Text := '拖拽文件或点击"新建"开始';
    vsFileLoaded: LblStatus.Text := ExtractFileName(FSourcePath) + ' 已加载';
    vsAnalyzing: LblStatus.Text := 'AI 正在分析...';
    vsContractReady: LblStatus.Text := '契约已生成，等待确认';
    vsGeneratingTest: LblStatus.Text := '生成测试脚本中...';
    vsRunningTest: LblStatus.Text := '运行测试中...';
    vsFixing: LblStatus.Text := 'AI 修复中...';
    vsPassed: LblStatus.Text := '验证通过！';
    vsFailed: LblStatus.Text := '验证失败';
  end;
  
  PrgProgress.Visible := FCurrentState in [vsAnalyzing, vsGeneratingTest, vsRunningTest, vsFixing];
end;

end.
