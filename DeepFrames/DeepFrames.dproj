        <DCC_Namespace>Vcl;Vcl.Imaging;Vcl.Touch;Vcl.Samples;Vcl.Shell;System;Xml;Data;Datasnap;Web;Soap;$(DCC_Namespace)</DCC_Namespace>
        <DCC_UnitSearchPath>src\App;src\UI;src\Domain;src\Persistence;src\Workflow;src\Shared;src\Provider;..\..\02Business\DeepBase\Core;..\..\02Business\DeepBase\VCL;..\..\02Business\DeepBase\Persistence;$(DCC_UnitSearchPath)</DCC_UnitSearchPath>
        <VerInfo_Locale>1033</VerInfo_Locale>
        <VerInfo_Keys>CompanyName=;FileDescription=DeepFrames;FileVersion=1.0.0.0;InternalName=;LegalCopyright=;LegalTrademarks=;OriginalFilename=;ProductName=DeepFrames;ProductVersion=1.0.0.0;Comments=</VerInfo_Keys>
