{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deepspec.dev/schemas/v1/tree.schema.json",
  "title": "DeepSpec Tree File",
  "description": "Schema for function-tree.yaml, module-tree.yaml, view-tree.yaml, and data-tree.yaml. v1.2-draft keeps legacy status readable while introducing orthogonal gen_status and review_status.",
  "type": "object",
  "required": ["version", "tree", "generated_at", "generator", "nodes"],
  "additionalProperties": true,
  "properties": {
    "version": {"type": "string", "enum": ["1.0", "1.1", "1.2"]},
    "tree": {"$ref": "#/$defs/tree_type"},
    "generated_at": {"type": "string", "format": "date-time"},
    "generator": {"type": "string"},
    "nodes": {"type": "array", "items": {"$ref": "#/$defs/node"}}
  },
  "$defs": {
    "tree_type": {"type": "string", "enum": ["function", "module", "view", "data"]},
    "legacy_node_status": {"type": "string", "enum": ["candidate", "confirmed", "uncertain", "rejected", "superseded"], "description": "Deprecated combined status. Readers may map it to gen_status/review_status."},
    "gen_status": {"type": "string", "enum": ["pending", "generated", "failed"], "default": "generated"},
    "review_status": {"type": "string", "enum": ["pending", "accepted", "rejected", "locked"], "default": "pending"},
    "confidence_level": {"type": "string", "enum": ["low", "medium", "high"]},
    "source_layer": {"type": "string", "enum": ["parsed_from_a", "human_decision", "ai_inferred", "generated_summary"]},
    "function_kind": {"type": "string", "enum": ["feature", "capability", "user_story", "use_case", "rule", "constraint", "non_functional", "integration"]},
    "module_kind": {"type": "string", "enum": ["package", "unit", "class", "interface", "service", "repository", "controller", "adapter", "utility", "config"]},
    "view_kind": {"type": "string", "enum": ["application", "window", "dialog", "page", "frame", "panel", "control", "menu", "toolbar", "statusbar", "tray"]},
    "data_kind": {"type": "string", "enum": ["entity", "field", "relation", "state", "migration", "constraint"]},
    "risk_score": {"type": "string", "enum": ["low", "medium", "high", "critical"]},
    "kind": {
      "type": "string",
      "description": "Node kind. Must be a built-in value or start with x_ for extensions.",
      "anyOf": [
        {"$ref": "#/$defs/function_kind"},
        {"$ref": "#/$defs/module_kind"},
        {"$ref": "#/$defs/view_kind"},
        {"$ref": "#/$defs/data_kind"},
        {"type": "string", "pattern": "^x_[a-z][a-z0-9_]*$"}
      ]
    },
    "source_ref": {
      "type": "object",
      "required": ["ref_id"],
      "additionalProperties": true,
      "properties": {
        "ref_id": {"type": "string", "pattern": "^ev-"},
        "relevance": {"type": ["string", "null"], "enum": ["primary", "supporting", "contradicting", null]},
        "note": {"type": ["string", "null"]}
      }
    },
    "transition": {
      "type": "object",
      "required": ["from", "to"],
      "additionalProperties": true,
      "properties": {
        "from": {"type": "string"},
        "to": {"type": "string"},
        "trigger": {"type": ["string", "null"]}
      }
    },
    "node": {
      "type": "object",
      "required": ["id", "tree", "title", "kind"],
      "additionalProperties": true,
      "properties": {
        "id": {"type": "string", "pattern": "^(func|mod|view|data)-[a-z0-9][a-z0-9\\-]{0,79}$"},
        "tree": {"$ref": "#/$defs/tree_type"},
        "title": {"type": "string", "minLength": 1},
        "kind": {"$ref": "#/$defs/kind"},
        "parent_id": {"type": ["string", "null"]},
        "slug_override": {"type": ["string", "null"]},
        "created_at": {"type": "string", "format": "date-time"},
        "updated_at": {"type": "string", "format": "date-time"},
        "content_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "relation_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "revision": {"type": "integer", "minimum": 1, "default": 1},
        "summary": {"type": "string"},
        "status": {"$ref": "#/$defs/legacy_node_status"},
        "gen_status": {"$ref": "#/$defs/gen_status"},
        "review_status": {"$ref": "#/$defs/review_status"},
        "confidence": {"$ref": "#/$defs/confidence_level"},
        "source_layer": {"$ref": "#/$defs/source_layer"},
        "source_refs": {"type": "array", "items": {"$ref": "#/$defs/source_ref"}, "default": []},
        "decision_refs": {"type": "array", "items": {"type": "string"}, "default": []},
        "issue_refs": {"type": "array", "items": {"type": "string"}, "default": []},
        "related_functions": {"type": "array", "items": {"type": "string"}, "default": []},
        "related_modules": {"type": "array", "items": {"type": "string"}, "default": []},
        "related_views": {"type": "array", "items": {"type": "string"}, "default": []},
        "related_data": {"type": "array", "items": {"type": "string"}, "default": []},
        "children": {"type": "array", "items": {"type": "string"}, "default": []},
        "tags": {"type": "array", "items": {"type": "string"}, "default": []},
        "acceptance_criteria": {"type": "array", "items": {"type": "string"}, "default": []},
        "not_doing": {"type": "array", "items": {"type": "string"}, "default": []},
        "risk_score": {"$ref": "#/$defs/risk_score"},
        "data_type": {"type": "string"},
        "nullable": {"type": "boolean"},
        "default_value": {"type": ["string", "number", "boolean", "null"]},
        "field_constraints": {"type": "array", "items": {"type": "string"}},
        "persistence": {"type": "string", "enum": ["memory", "db", "file", "cache", "external"]},
        "source_entity": {"type": "string"},
        "target_entity": {"type": "string"},
        "cardinality": {"type": "string", "enum": ["one_to_one", "one_to_many", "many_to_one", "many_to_many"]},
        "cascade": {"type": "string"},
        "valid_states": {"type": "array", "items": {"type": "string"}},
        "transitions": {"type": "array", "items": {"$ref": "#/$defs/transition"}},
        "backward_compatible": {"type": "boolean"},
        "has_rollback": {"type": "boolean"},
        "scope": {"type": "string"},
        "enforcement": {"type": "string", "enum": ["application", "database", "both", "external"]}
      }
    }
  }
}

