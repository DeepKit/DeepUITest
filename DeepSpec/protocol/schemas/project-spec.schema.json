{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deepspec.dev/schemas/v1/project-spec.schema.json",
  "title": "DeepSpec Project Specification",
  "description": "Root index file for a .deepspec directory. References all fact files.",
  "type": "object",
  "required": ["version", "project", "summary", "trees"],
  "properties": {
    "version": {
      "type": "string",
      "const": "1.0",
      "description": "Protocol version"
    },
    "project": {
      "type": "object",
      "required": ["name", "path", "type", "scan_time"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 },
        "type": {
          "type": "string",
          "description": "Project type identifier",
          "examples": ["delphi_vcl", "web_react", "python_backend", "mixed"]
        },
        "scan_time": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "summary": {
      "type": "object",
      "required": ["total_nodes", "confirmed_nodes", "uncertain_nodes", "open_issues", "decisions_count"],
      "properties": {
        "total_nodes": { "type": "integer", "minimum": 0 },
        "confirmed_nodes": { "type": "integer", "minimum": 0 },
        "uncertain_nodes": { "type": "integer", "minimum": 0 },
        "open_issues": { "type": "integer", "minimum": 0 },
        "decisions_count": { "type": "integer", "minimum": 0 }
      }
    },
    "trees": {
      "type": "object",
      "required": ["function_tree", "module_tree", "view_tree"],
      "properties": {
        "function_tree": { "type": "string" },
        "module_tree": { "type": "string" },
        "view_tree": { "type": "string" }
      }
    },
    "relations": { "type": "string" },
    "evidence": { "type": "string" },
    "issues": { "type": "string" },
    "decisions": { "type": "string" },
    "imports": {
      "type": "array",
      "items": { "$ref": "#/$defs/import_entry" },
      "default": []
    }
  },
  "$defs": {
    "import_entry": {
      "type": "object",
      "required": ["alias", "path"],
      "properties": {
        "alias": { "type": "string" },
        "path": { "type": "string" },
        "version_lock": { "type": ["string", "null"] },
        "scope": {
          "type": "string",
          "enum": ["all", "trees", "modules", "views", "decisions"]
        }
      }
    }
  }
}
