[Unit]
Description=goodmem.cn FastAPI Service
After=network.target

[Service]
User=www-data
Group=www-data
WorkingDirectory=/srv/goodmem.cn/app/current/goodmem.cn/backend
EnvironmentFile=/srv/goodmem.cn/env/backend.env
ExecStart=/srv/goodmem.cn/app/current/goodmem.cn/backend/venv/bin/uvicorn main:app --host 127.0.0.1 --port 8000
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
