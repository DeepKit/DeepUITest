  "components": {
    "schemas": {
      "AuthLoginRequest": {
        "properties": {
          "login_type": {
            "type": "string",
            "title": "Login Type"
          },
          "app_id": {
            "type": "string",
            "title": "App Id"
          },
          "device_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Device Id"
          },
          "device_fingerprint": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Device Fingerprint"
          },
          "email": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Email"
          },
          "password": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Password"
          },
          "code": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Code"
          },
          "provider_user_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Provider User Id"
          },
          "union_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Union Id"
          }
        },
        "type": "object",
        "required": [
          "login_type",
          "app_id"
        ],
        "title": "AuthLoginRequest"
      },
      "AuthLogoutRequest": {
        "properties": {
          "refresh_token": {
            "type": "string",
            "title": "Refresh Token"
          }
        },
        "type": "object",
        "required": [
          "refresh_token"
        ],
        "title": "AuthLogoutRequest"
      },
      "AuthRefreshRequest": {
        "properties": {
          "refresh_token": {
            "type": "string",
            "title": "Refresh Token"
          }
        },
        "type": "object",
        "required": [
          "refresh_token"
        ],
        "title": "AuthRefreshRequest"
      },
      "ConsumeEntitlementRequest": {
        "properties": {
          "app_id": {
            "type": "string",
            "title": "App Id"
          },
          "entitlement_code": {
            "type": "string",
            "title": "Entitlement Code"
          },
          "feature_code": {
            "type": "string",
            "title": "Feature Code",
            "default": ""
          },
          "quantity": {
            "type": "integer",
            "exclusiveMinimum": 0.0,
            "title": "Quantity",
            "default": 1
          },
          "request_id": {
            "type": "string",
            "title": "Request Id",
            "default": ""
          }
        },
        "type": "object",
        "required": [
          "app_id",
          "entitlement_code"
        ],
        "title": "ConsumeEntitlementRequest"
      },
      "CreateOrderRequest": {
        "properties": {
          "user_id": {
            "type": "string",
            "title": "User Id"
          },
          "app_id": {
            "type": "string",
            "title": "App Id"
          },
          "product_id": {
            "type": "string",
            "title": "Product Id"
          }
        },
        "type": "object",
        "required": [
          "user_id",
          "app_id",
          "product_id"
        ],
        "title": "CreateOrderRequest"
      },
      "CreatePaymentIntentRequest": {
        "properties": {
          "order_id": {
            "type": "string",
            "title": "Order Id"
          },
          "provider": {
            "type": "string",
            "title": "Provider"
          },
          "channel": {
            "type": "string",
            "title": "Channel"
          },
          "payer_open_id": {
            "type": "string",
            "title": "Payer Open Id",
            "default": ""
          }
        },
        "type": "object",
        "required": [
          "order_id",
          "provider",
          "channel"
        ],
        "title": "CreatePaymentIntentRequest"
      },
      "EnsureUserRequest": {
        "properties": {
          "provider": {
            "type": "string",
            "title": "Provider"
          },
          "provider_user_id": {
            "type": "string",
            "title": "Provider User Id"
          },
          "app_id": {
            "type": "string",
            "title": "App Id"
          },
          "union_id": {
            "type": "string",
            "title": "Union Id",
            "default": ""
          },
          "display_name": {
            "type": "string",
            "title": "Display Name",
            "default": ""
          },
          "email": {
            "type": "string",
            "title": "Email",
            "default": ""
          },
          "phone": {
            "type": "string",
            "title": "Phone",
            "default": ""
          }
        },
        "type": "object",
        "required": [
          "provider",
          "provider_user_id",
          "app_id"
        ],
        "title": "EnsureUserRequest"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "LicenseSnapshotRequest": {
        "properties": {
          "app_id": {
            "type": "string",
            "title": "App Id"
          },
          "device_id": {
            "type": "string",
            "title": "Device Id"
          },
          "snapshot_id": {
            "type": "string",
            "title": "Snapshot Id",
            "default": ""
          }
        },
        "type": "object",
        "required": [
          "app_id",
          "device_id"
        ],
        "title": "LicenseSnapshotRequest"
      },
      "ManualPaymentConfirmRequest": {
        "properties": {
          "out_trade_no": {
            "type": "string",
            "title": "Out Trade No"
          },
          "provider_trade_no": {
            "type": "string",
            "title": "Provider Trade No"
          },
