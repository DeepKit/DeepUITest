        "type": "object",
        "required": [
          "out_trade_no",
          "provider_trade_no",
          "amount_minor"
        ],
        "title": "ManualPaymentConfirmRequest"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
